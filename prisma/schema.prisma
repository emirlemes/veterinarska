generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  VETERINARIAN
}

enum AnimalStatus {
  ACTIVE
  DECEASED
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ExaminationStatus {
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum StockMovementType {
  RECEIPT
  ADMINISTRATION
  ADJUSTMENT
  REVERSAL
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  firstName      String          @map("first_name") @db.VarChar(100)
  lastName       String          @map("last_name") @db.VarChar(100)
  email          String          @unique @db.VarChar(254)
  phone          String?         @db.VarChar(40)
  passwordHash   String          @map("password_hash")
  role           Role            @default(VETERINARIAN)
  isActive       Boolean         @default(true) @map("is_active")
  appointments   Appointment[]   @relation("AppointmentVeterinarian")
  examinations   Examination[]   @relation("ExaminationVeterinarian")
  stockMovements StockMovement[]
  payments       Payment[]       @relation("PaymentRecorder")
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@map("users")
}

model Client {
  id           String               @id @default(uuid()) @db.Uuid
  firstName    String               @map("first_name") @db.VarChar(100)
  lastName     String               @map("last_name") @db.VarChar(100)
  companyName  String?              @map("company_name") @db.VarChar(180)
  phone        String               @db.VarChar(40)
  email        String?              @db.VarChar(254)
  address      String?              @db.VarChar(240)
  city         String?              @db.VarChar(120)
  postalCode   String?              @map("postal_code") @db.VarChar(20)
  notes        String?              @db.Text
  isActive     Boolean              @default(true) @map("is_active")
  animals      Animal[]
  ownerHistory AnimalOwnerHistory[]
  appointments Appointment[]
  examinations Examination[]
  invoices     Invoice[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([lastName, firstName])
  @@index([phone])
  @@map("clients")
}

model Animal {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @db.VarChar(120)
  species              String               @db.VarChar(80)
  breed                String?              @db.VarChar(120)
  sex                  String?              @db.VarChar(30)
  dateOfBirth          DateTime?            @map("date_of_birth") @db.Date
  color                String?              @db.VarChar(80)
  weightKg             Decimal?             @map("weight_kg") @db.Decimal(7, 3)
  microchipNumber      String?              @unique @map("microchip_number") @db.VarChar(80)
  passportNumber       String?              @map("passport_number") @db.VarChar(80)
  identificationNumber String?              @map("identification_number") @db.VarChar(80)
  ownerId              String               @map("owner_id") @db.Uuid
  allergies            String?              @db.Text
  chronicConditions    String?              @map("chronic_conditions") @db.Text
  notes                String?              @db.Text
  status               AnimalStatus         @default(ACTIVE)
  owner                Client               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerHistory         AnimalOwnerHistory[]
  appointments         Appointment[]
  examinations         Examination[]
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([name])
  @@index([ownerId])
  @@index([species, status])
  @@map("animals")
}

model AnimalOwnerHistory {
  id         String    @id @default(uuid()) @db.Uuid
  animalId   String    @map("animal_id") @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  validFrom  DateTime  @default(now()) @map("valid_from")
  validUntil DateTime? @map("valid_until")
  notes      String?   @db.Text
  animal     Animal    @relation(fields: [animalId], references: [id], onDelete: Restrict)
  owner      Client    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([animalId, validFrom])
  @@map("animal_owner_history")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  animalId       String            @map("animal_id") @db.Uuid
  veterinarianId String            @map("veterinarian_id") @db.Uuid
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  reason         String            @db.VarChar(240)
  notes          String?           @db.Text
  status         AppointmentStatus @default(SCHEDULED)
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  animal         Animal            @relation(fields: [animalId], references: [id], onDelete: Restrict)
  veterinarian   User              @relation("AppointmentVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  examination    Examination?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([startsAt, status])
  @@index([veterinarianId, startsAt, endsAt])
  @@index([clientId, startsAt])
  @@map("appointments")
}

model Examination {
  id              String                     @id @default(uuid()) @db.Uuid
  animalId        String                     @map("animal_id") @db.Uuid
  clientId        String                     @map("client_id") @db.Uuid
  veterinarianId  String                     @map("veterinarian_id") @db.Uuid
  appointmentId   String?                    @unique @map("appointment_id") @db.Uuid
  examinationDate DateTime                   @default(now()) @map("examination_date")
  chiefComplaint  String?                    @map("chief_complaint") @db.Text
  symptoms        String?                    @db.Text
  diagnosis       String?                    @db.Text
  treatmentPlan   String?                    @map("treatment_plan") @db.Text
  notes           String?                    @db.Text
  status          ExaminationStatus          @default(IN_PROGRESS)
  animal          Animal                     @relation(fields: [animalId], references: [id], onDelete: Restrict)
  client          Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  veterinarian    User                       @relation("ExaminationVeterinarian", fields: [veterinarianId], references: [id], onDelete: Restrict)
  appointment     Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  therapies       Therapy[]
  administrations MedicationAdministration[]
  services        ExaminationService[]
  invoice         Invoice?
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@index([animalId, examinationDate])
  @@index([clientId, examinationDate])
  @@map("examinations")
}

model Therapy {
  id            String      @id @default(uuid()) @db.Uuid
  examinationId String      @map("examination_id") @db.Uuid
  name          String      @db.VarChar(180)
  dosage        String?     @db.VarChar(160)
  frequency     String?     @db.VarChar(160)
  duration      String?     @db.VarChar(160)
  instructions  String?     @db.Text
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([examinationId])
  @@map("therapies")
}

model Medication {
  id               String                     @id @default(uuid()) @db.Uuid
  name             String                     @db.VarChar(180)
  activeIngredient String?                    @map("active_ingredient") @db.VarChar(180)
  form             String?                    @db.VarChar(100)
  strength         String?                    @db.VarChar(100)
  category         String?                    @db.VarChar(100)
  manufacturer     String?                    @db.VarChar(180)
  sellingPrice     Decimal?                   @map("selling_price") @db.Decimal(12, 2)
  unit             String                     @db.VarChar(40)
  minimumStock     Decimal                    @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  isActive         Boolean                    @default(true) @map("is_active")
  batches          MedicationBatch[]
  administrations  MedicationAdministration[]
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@index([name])
  @@map("medications")
}

model MedicationBatch {
  id                String                     @id @default(uuid()) @db.Uuid
  medicationId      String                     @map("medication_id") @db.Uuid
  batchNumber       String                     @map("batch_number") @db.VarChar(100)
  expiresAt         DateTime?                  @map("expires_at") @db.Date
  quantityReceived  Decimal                    @map("quantity_received") @db.Decimal(12, 3)
  quantityRemaining Decimal                    @map("quantity_remaining") @db.Decimal(12, 3)
  purchasePrice     Decimal?                   @map("purchase_price") @db.Decimal(12, 2)
  medication        Medication                 @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  movements         StockMovement[]
  administrations   MedicationAdministration[]
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([medicationId, batchNumber])
  @@index([medicationId, expiresAt])
  @@map("medication_batches")
}

model MedicationAdministration {
  id             String          @id @default(uuid()) @db.Uuid
  examinationId  String          @map("examination_id") @db.Uuid
  medicationId   String          @map("medication_id") @db.Uuid
  batchId        String          @map("batch_id") @db.Uuid
  quantity       Decimal         @db.Decimal(12, 3)
  administeredAt DateTime        @default(now()) @map("administered_at")
  notes          String?         @db.Text
  examination    Examination     @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  medication     Medication      @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  batch          MedicationBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  stockMovement  StockMovement?

  @@index([examinationId])
  @@map("medication_administrations")
}

model StockMovement {
  id               String                    @id @default(uuid()) @db.Uuid
  batchId          String                    @map("batch_id") @db.Uuid
  userId           String                    @map("user_id") @db.Uuid
  administrationId String?                   @unique @map("administration_id") @db.Uuid
  type             StockMovementType
  quantity         Decimal                   @db.Decimal(12, 3)
  reason           String?                   @db.VarChar(240)
  batch            MedicationBatch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  administration   MedicationAdministration? @relation(fields: [administrationId], references: [id], onDelete: Restrict)
  createdAt        DateTime                  @default(now()) @map("created_at")

  @@index([batchId, createdAt])
  @@index([userId, createdAt])
  @@map("stock_movements")
}

model Service {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(180)
  description  String?              @db.Text
  price        Decimal              @db.Decimal(12, 2)
  isActive     Boolean              @default(true) @map("is_active")
  examinations ExaminationService[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@index([name])
  @@map("services")
}

model ExaminationService {
  id            String      @id @default(uuid()) @db.Uuid
  examinationId String      @map("examination_id") @db.Uuid
  serviceId     String      @map("service_id") @db.Uuid
  priceAtTime   Decimal     @map("price_at_time") @db.Decimal(12, 2)
  quantity      Decimal     @default(1) @db.Decimal(10, 2)
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([examinationId])
  @@map("examination_services")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  clientId      String        @map("client_id") @db.Uuid
  examinationId String?       @unique @map("examination_id") @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?     @map("issued_at")
  dueAt         DateTime?     @map("due_at")
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate       Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  notes         String?       @db.Text
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  examination   Examination?  @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([clientId, issuedAt])
  @@index([status, dueAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String  @db.VarChar(240)
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id           String            @id @default(uuid()) @db.Uuid
  invoiceId    String            @map("invoice_id") @db.Uuid
  recordedById String            @map("recorded_by_id") @db.Uuid
  amount       Decimal           @db.Decimal(12, 2)
  method       PaymentMethod
  paidAt       DateTime          @default(now()) @map("paid_at")
  reference    String?           @db.VarChar(120)
  invoice      Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy   User              @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  reversals    PaymentReversal[]
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([invoiceId, paidAt])
  @@index([recordedById, paidAt])
  @@map("payments")
}

model PaymentReversal {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  reason     String   @db.VarChar(240)
  reversedAt DateTime @default(now()) @map("reversed_at")
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, reversedAt])
  @@map("payment_reversals")
}

model ClinicSettings {
  id                         String   @id @default("default")
  clinicName                 String   @default("Veterinarska ambulanta") @map("clinic_name") @db.VarChar(180)
  address                    String?  @db.VarChar(240)
  city                       String?  @db.VarChar(120)
  phone                      String?  @db.VarChar(40)
  email                      String?  @db.VarChar(254)
  taxIdentificationNumber    String?  @map("tax_identification_number") @db.VarChar(80)
  defaultCurrency            String   @default("BAM") @map("default_currency") @db.VarChar(3)
  invoicePrefix              String   @default("RAC") @map("invoice_prefix") @db.VarChar(12)
  nextInvoiceNumber          Int      @default(1) @map("next_invoice_number")
  defaultTaxRate             Decimal  @default(0) @map("default_tax_rate") @db.Decimal(5, 2)
  appointmentDurationMinutes Int      @default(30) @map("appointment_duration_minutes")
  workingHours               Json?    @map("working_hours")
  logoUrl                    String?  @map("logo_url") @db.VarChar(500)
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(120)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  details    Json?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
